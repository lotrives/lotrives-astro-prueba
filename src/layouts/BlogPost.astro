---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import FloatingTOC from '../components/FloatingTOC.astro';
import PageScripts from '../components/PageScripts.astro';
import ResaltadoBusqueda from '../components/ResaltadoBusqueda.astro';
import { etiquetasConPagina, pildorasDe, slugify, urlEtiqueta } from '../utils/etiquetas';

type Props = CollectionEntry<'blog'>['data'] & {
	prev?: { title: string; url: string } | null;
	next?: { title: string; url: string } | null;
};

const { title, description, pubDate, updatedDate, heroImage, tags, author, prev, next } = Astro.props;

const truncate = (str: string, max: number) =>
	str.length > max ? str.slice(0, max).trimEnd() + '…' : str;

// Etiquetas del pie: solo las que tienen página propia (3 o más entradas),
// con el mismo criterio que la portada y /etiquetas/.
const _conPagina = await etiquetasConPagina();
const _vistas = new Set<string>();
const visibleTags = (tags ?? []).filter((t) => {
	const slug = slugify(t);
	if (!_conPagina.has(slug) || _vistas.has(slug)) return false;
	_vistas.add(slug);
	return true;
});

// Datos para el buscador (Pagefind; ver scripts/build-pagefind.mjs).
// La fecha sirve para ordenar y filtrar; el antetítulo, para pintar la tarjeta del resultado.
const fechaIso = new Date(pubDate).toISOString().slice(0, 10);
// Solo nombres separados por «|»: los metadatos también se buscan, así que nada de palabras auxiliares.
const antetitulo = pildorasDe(tags, _conPagina).map((e) => e.nombre).join('|');
const todasLasEtiquetas = [...new Set(tags ?? [])];

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "BlogPosting",
	"headline": title,
	"description": description,
	"datePublished": new Date(pubDate).toISOString(),
	...(updatedDate ? { "dateModified": new Date(updatedDate).toISOString() } : {}),
	"author": {
		"@type": "Person",
		"name": author
	},
	"image": new URL(heroImage ?? '/assets/images/og-default.webp', Astro.site).toString(),
};
---

<html lang="es">
	<head>
		<BaseHead
			title={title}
			description={description}
			image={heroImage}
			type="article"
			publishedTime={new Date(pubDate)}
			modifiedTime={updatedDate ? new Date(updatedDate) : undefined}
			jsonLd={jsonLd}
		/>
		<style>
	main {
		width: calc(100% - 2em);
		max-width: 100%;
		margin: 0;
		padding-top: 0.5em;
	}
	.prose {
		width: 700px;
		max-width: calc(100% - 2em);
		margin: auto;
		padding: 1em;
		color: rgb(var(--gray-dark));
	}
	.title {
		margin-bottom: 1em;
		padding: 0;
		text-align: left;
		line-height: 1;
	}
	.title h1 {
		margin: 0 0 0.4em 0;
		font-size: 2.25rem;
		font-weight: 700;
		line-height: 1.2;
	}
	.date {
		margin-top: 0.4em;
		margin-bottom: 0.5em;
		color: rgb(var(--gray));
		font-size: 0.9em;
	}
	.date .autor {
		color: rgb(var(--black));
	}
	.last-updated-on {
		font-style: normal;
	}

	.updated-short {
		display: none;
	}

	@media (max-width: 560px) {
		.date-separator {
			display: none;
		}

		.published-date {
			display: block;
		}

		.updated-long {
			display: none;
		}

		.updated-short {
			display: inline;
		}
	}
	.tags {
		margin-top: 2em;
		padding-top: 1em;
		border-top: 1px solid rgb(var(--gray-light));
		font-size: 0.85em;
		color: rgb(var(--gray));
	}
	.tags a {
		color: rgb(var(--gray));
		text-decoration: underline;
		text-underline-offset: 3px;
		text-decoration-color: rgb(var(--gray-light));
	}
	.tags a:hover {
		color: var(--accent);
	}
	.nav-posts {
		margin-top: 2em;
		padding-top: 1em;
		border-top: 1px solid rgb(var(--gray-light));
		display: flex;
		justify-content: space-between;
		gap: 1em;
		font-size: 0.85em;
		color: rgb(var(--gray));
	}
	.nav-posts a {
		color: rgb(var(--gray));
		text-decoration: underline;
		text-underline-offset: 3px;
		text-decoration-color: rgb(var(--gray-light));
	}
	.nav-posts a:hover {
		color: var(--accent);
	}
	.nav-prev { text-align: left; }
	.nav-next { text-align: right; margin-left: auto; }
</style>
	</head>

	<body>
		<Header />
		<main>
			<article
				data-pagefind-body
				data-pagefind-meta="fecha[data-fecha], antetitulo[data-antetitulo]"
				data-pagefind-sort="fecha[data-fecha]"
				data-pagefind-filter="anio[data-anio], tipo:texto"
				data-fecha={fechaIso}
				data-anio={fechaIso.slice(0, 4)}
				data-antetitulo={antetitulo}
			>
				<div class="prose">
					<div class="title">
						<h1 data-pagefind-meta="title" data-pagefind-ignore>{title}</h1>
						<div class="date" data-pagefind-ignore>
							<div class="published-line">
								<span class="autor">José Manuel Grau Navarro</span>
								<span class="date-separator"> · </span>
								<span class="published-date">
									<FormattedDate date={pubDate} compactOnMobile />
								</span>
							</div>
							{updatedDate && (
								<div class="last-updated-on">
									<span class="updated-long">Actualizado el </span>
									<span class="updated-short">Actualizado </span>
									<FormattedDate date={updatedDate} compactOnMobile />
								</div>
							)}
						</div>
						<hr />
					</div>
					{/*
						Para el buscador: el título (arriba), las etiquetas, la entradilla y los alias
						van como metadatos, que se buscan con su propio peso (ver buscar.astro) sin
						ensuciar los fragmentos de los resultados, que salen del cuerpo del texto.
					*/}
					<div class="solo-buscador" aria-hidden="true" data-pagefind-ignore>
						{todasLasEtiquetas.length > 0 && (
							<p data-pagefind-meta="etiquetas">
								{todasLasEtiquetas.map((tag, i) => (
									<>
										{i > 0 && ' · '}
										<span data-pagefind-filter="etiqueta">{tag}</span>
									</>
								))}
							</p>
						)}
						{description && <p data-pagefind-meta="entradilla">{description}</p>}
						<span data-pagefind-alias></span>
					</div>
					<slot />
					{visibleTags.length > 0 && (
						<div class="tags" data-pagefind-ignore>
							{visibleTags.map((tag, i) => (
								<>
									{i > 0 && ' · '}
									<a href={urlEtiqueta(tag)}>{tag}</a>
								</>
							))}
						</div>
					)}
					<nav class="nav-posts" data-pagefind-ignore>
						{prev && (
							<span class="nav-prev">
								<a href={prev.url}>← {truncate(prev.title, 50)}</a>
							</span>
						)}
						{next && (
							<span class="nav-next">
								<a href={next.url}>{truncate(next.title, 50)} →</a>
							</span>
						)}
					</nav>
				</div>
			</article>
		</main>
		<FloatingTOC />
		<Footer />
		<ResaltadoBusqueda />
	</body>
</html>
<PageScripts />
