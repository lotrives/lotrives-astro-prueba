---
import { getEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import FloatingTOC from '../components/FloatingTOC.astro';
import PageScripts from '../components/PageScripts.astro';
import ResaltadoBusqueda from '../components/ResaltadoBusqueda.astro';
import { etiquetasConPagina, pildorasDe } from '../utils/etiquetas';

const { title, description, wide } = Astro.props;

// Si esta página sale de src/content/pages/ (acerca, libros…), entra en el buscador
// con su título, su descripción y sus etiquetas. Las demás páginas no se indexan.
const id = Astro.url.pathname.replace(/^\/+|\/+$/g, '');
const entrada = id && !id.includes('/') ? await getEntry('pages', id) : undefined;
const etiquetas = [...new Set(entrada?.data.tags ?? [])];
const antetitulo = entrada
	? pildorasDe(etiquetas, await etiquetasConPagina()).map((e) => e.nombre).join('|')
	: '';
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead
			title={title}
			description={description || ''}
		/>
	</head>
	<body>
		<Header />
		<main>
			{
				entrada ? (
					<section
						class={wide ? 'page wide' : 'page'}
						data-pagefind-body
						data-pagefind-meta="title[data-titulo], antetitulo[data-antetitulo]"
						data-pagefind-filter="tipo:página"
						data-titulo={entrada.data.title}
						data-antetitulo={antetitulo}
					>
						<div class="solo-buscador" aria-hidden="true" data-pagefind-ignore>
							{etiquetas.length > 0 && (
								<p data-pagefind-meta="etiquetas">
									{etiquetas.map((tag, i) => (
										<>
											{i > 0 && ' · '}
											<span data-pagefind-filter="etiqueta">{tag}</span>
										</>
									))}
								</p>
							)}
							{entrada.data.description && <p data-pagefind-meta="entradilla">{entrada.data.description}</p>}
							<span data-pagefind-alias></span>
						</div>
						<slot />
					</section>
				) : (
					<section class={wide ? 'page wide' : 'page'}>
						<slot />
					</section>
				)
			}
		</main>
		<FloatingTOC />
		<Footer />
		<PageScripts />
		<ResaltadoBusqueda />
	</body>
</html>

<style>
	.page {
		max-width: 700px;
		margin: 0 auto;
		padding: 1.5rem 1.5rem;
	}
	.page.wide {
		max-width: 820px;
	}
</style>
