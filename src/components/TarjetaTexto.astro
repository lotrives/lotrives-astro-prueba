---
// Tarjeta de un texto: título, descripción, píldoras de etiquetas y fecha.
import FormattedDate from './FormattedDate.astro';

interface Props {
	title: string;
	description?: string;
	href: string;
	date: Date;
	heroImage?: string;
	etiquetas?: { nombre: string; href: string }[];
}

const { title, description, href, date, heroImage, etiquetas = [] } = Astro.props;
---

<article class="tarjeta">
	<div class="tarjeta-contenido">
		<h2 class="tarjeta-titulo"><a href={href}>{title}</a></h2>
		{description && <p class="tarjeta-descripcion">{description}</p>}
		<div class="tarjeta-pie">
			{
				etiquetas.length > 0 && (
					<ul class="pildoras">
						{etiquetas.map((e) => (
							<li>
								<a class="pildora" href={e.href}>
									{e.nombre}
								</a>
							</li>
						))}
					</ul>
				)
			}
			<span class="tarjeta-fecha"><FormattedDate date={date} compactOnMobile /></span>
		</div>
	</div>
	{heroImage && <img class="tarjeta-miniatura" src={heroImage} alt="" loading="lazy" width="160" height="90" />}
</article>

<style>
	.tarjeta {
		display: flex;
		align-items: flex-start;
		gap: 1.3rem;
		padding: 1.4rem 0;
		border-top: 1px solid rgb(var(--gray-light));
	}
	.tarjeta:first-child {
		border-top: none;
	}
	.tarjeta-contenido {
		flex: 1;
		min-width: 0;
	}
	.tarjeta-titulo {
		margin: 0;
		font-size: 1.15em;
		font-weight: 700;
		line-height: 1.3;
	}
	.tarjeta-titulo a {
		color: rgb(var(--black));
		text-decoration: none;
	}
	.tarjeta-titulo a:hover {
		color: var(--accent);
		text-decoration: underline;
		text-underline-offset: 3px;
		text-decoration-color: var(--accent);
	}
	.tarjeta-descripcion {
		margin: 0.45em 0 0;
		font-size: 0.92em;
		color: rgb(var(--gray));
		line-height: 1.5;
	}
	.tarjeta-pie {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem 0.8rem;
		margin-top: 0.8rem;
	}
	.pildoras {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.pildora {
		display: inline-block;
		padding: 0 0.85em;
		border-radius: 999px;
		background: rgba(var(--nota), 0.12);
		color: rgb(var(--gray));
		font-size: 0.63em;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		text-decoration: none;
		line-height: 1.7;
		transition: color 0.15s;
	}
	.pildora:hover {
		color: var(--accent);
		text-decoration: none;
	}
	.tarjeta-fecha {
		font-size: 0.8em;
		color: rgb(var(--gray));
	}
	.tarjeta-miniatura {
		flex-shrink: 0;
		width: 160px;
		height: 90px;
		object-fit: cover;
		border-radius: 4px;
		background: rgb(var(--gray-light));
	}
	@media (max-width: 560px) {
		.tarjeta {
			flex-direction: column;
		}
		.tarjeta-miniatura {
			width: 100%;
			height: auto;
			aspect-ratio: 16 / 9;
		}
	}
</style>
