---
// Tarjeta de un texto, con jerarquía de antetítulo:
// etiquetas (antetítulo) → título → fecha → descripción, y miniatura a la derecha.
// Las páginas estáticas no tienen fecha: sin `date`, la línea de la fecha no aparece.
import FormattedDate from './FormattedDate.astro';

interface Props {
	title: string;
	description?: string;
	href: string;
	date?: Date;
	heroImage?: string;
	etiquetas?: { nombre: string; href: string }[];
}

const { title, description, href, date, heroImage, etiquetas = [] } = Astro.props;
---

<article class="tarjeta">
	<div class="tarjeta-contenido">
		{
			etiquetas.length > 0 && (
				<ul class="antetitulo" aria-label="Etiquetas">
					{etiquetas.map((e) => (
						<li>
							<a href={e.href}>{e.nombre}</a>
						</li>
					))}
				</ul>
			)
		}
		<h2 class="tarjeta-titulo"><a href={href}>{title}</a></h2>
		{date && <p class="tarjeta-fecha"><FormattedDate date={date} /></p>}
		{description && <p class="tarjeta-descripcion">{description}</p>}
	</div>
	{
		heroImage && (
			// La foto lleva al texto, como el título. Oculta para lectores de pantalla
			// y teclado, que ya tienen el enlace del título.
			<a class="tarjeta-foto" href={href} tabindex="-1" aria-hidden="true">
				<img class="tarjeta-miniatura" src={heroImage} alt="" loading="lazy" width="160" height="90" />
			</a>
		)
	}
</article>

<style>
	.tarjeta {
		display: flex;
		align-items: flex-start;
		gap: 1.3rem;
		padding: 1.4rem 0;
		border-top: 1px solid rgb(var(--gray-light));
	}
	.tarjeta:first-child {
		border-top: none;
	}
	.tarjeta-contenido {
		flex: 1;
		min-width: 0;
	}

	/* Antetítulo: etiquetas en mayúsculas pequeñas, sin fondo, separadas por «·». */
	.antetitulo {
		display: flex;
		flex-wrap: wrap;
		list-style: none;
		margin: 0 0 0.35rem;
		padding: 0;
		font-size: 0.63em;
		letter-spacing: 0.09em;
		text-transform: uppercase;
		line-height: 1.6;
		/* Siempre una sola línea. Mientras carga, se recorta lo que salte;
		   después, el script oculta del todo las etiquetas que no caben. */
		max-height: 1.6em;
		overflow: hidden;
	}
	.antetitulo.ajustado {
		max-height: none;
		overflow: visible;
	}
	.antetitulo li {
		white-space: nowrap;
		min-width: 0;
	}
	/* La primera nunca cae: si no cabe sola, se recorta con puntos suspensivos. */
	.antetitulo li:first-child {
		max-width: 100%;
	}
	.antetitulo li:first-child a {
		max-width: 100%;
		overflow: hidden;
		text-overflow: ellipsis;
		vertical-align: top;
	}
	.antetitulo li + li::before {
		content: '·';
		content: '·' / ''; /* los lectores de pantalla no leen el punto */
		margin: 0 0.6em;
		color: rgb(var(--gray));
	}
	.antetitulo a {
		/* Zona de toque más alta que el texto, sin cambiar lo que se ve. */
		display: inline-block;
		padding: 0.45em 0;
		margin: -0.45em 0;
		color: rgb(var(--gray));
		text-decoration: none;
		transition: color 0.15s;
	}
	.antetitulo a:hover,
	.antetitulo a:active,
	.antetitulo a:focus-visible {
		color: var(--accent);
		text-decoration: none;
	}
	/* Pantallas táctiles (sin ratón): azul apagado para que se intuya que son enlaces. */
	@media (hover: none) {
		.antetitulo a {
			color: color-mix(in srgb, var(--accent) 55%, rgb(var(--gray)));
		}
		.antetitulo a:active {
			color: var(--accent);
		}
	}

	.tarjeta-titulo {
		margin: 0;
		font-size: 1.15em;
		font-weight: 700;
		line-height: 1.3;
	}
	.tarjeta-titulo a {
		color: rgb(var(--black));
		text-decoration: none;
	}
	.tarjeta-titulo a:hover,
	.tarjeta:has(.tarjeta-foto:hover) .tarjeta-titulo a {
		color: var(--accent);
		text-decoration: underline;
		text-underline-offset: 3px;
		text-decoration-color: var(--accent);
	}
	.tarjeta-fecha {
		margin: 0.25em 0 0;
		font-size: 0.78em;
		color: rgb(var(--gray));
	}
	.tarjeta-descripcion {
		margin: 0.45em 0 0;
		font-size: 0.92em;
		color: rgb(var(--gray));
		line-height: 1.5;
	}
	.tarjeta-foto {
		flex-shrink: 0;
		display: block;
		line-height: 0;
	}
	.tarjeta-miniatura {
		display: block;
		width: 160px;
		height: 90px;
		object-fit: cover;
		border-radius: 4px;
		background: rgb(var(--gray-light));
	}
	@media (max-width: 560px) {
		.tarjeta {
			flex-direction: column;
			gap: 0.9rem;
		}
		/* En el móvil la foto abre la tarjeta, para que no haya duda de a qué texto pertenece. */
		.tarjeta-foto {
			order: -1;
			width: 100%;
		}
		.tarjeta-miniatura {
			width: 100%;
			height: auto;
			aspect-ratio: 16 / 9;
		}
	}
</style>

<script>
	// Antetítulo en una sola línea: las etiquetas que saltarían a la segunda línea
	// se ocultan del todo (también para lectores de pantalla y teclado),
	// desde la primera que no cabe hasta el final. Se recalcula al cambiar el ancho.
	function ajustarAntetitulos() {
		document.querySelectorAll<HTMLUListElement>('.antetitulo').forEach((ul) => {
			const items = Array.from(ul.children) as HTMLElement[];
			items.forEach((li) => (li.hidden = false));
			ul.classList.add('ajustado');
			const primeraFila = items[0]?.offsetTop ?? 0;
			let cae = false;
			for (const li of items.slice(1)) {
				if (cae || li.offsetTop > primeraFila) {
					cae = true;
					li.hidden = true;
				}
			}
		});
	}

	let pendiente = 0;
	const programar = () => {
		cancelAnimationFrame(pendiente);
		pendiente = requestAnimationFrame(ajustarAntetitulos);
	};

	ajustarAntetitulos();
	window.addEventListener('resize', programar);
	document.fonts?.ready.then(programar);
</script>
