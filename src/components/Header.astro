---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<header>
  <nav aria-label="Menú principal">
    <div class="brand"><a href={`${base}/`} class="brand-link"><img src={`${base}/favicon.svg`} alt="" width="32" height="32" class="logo-mark" />{SITE_TITLE}</a></div>
    <!-- Lupa siempre visible en el móvil, junto al menú. En el ordenador, la del menú. -->
    <a href={`${base}/buscar/`} class="lupa-movil" aria-label="Buscar"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg></a>
    <button class="hamburger" id="menu-toggle" type="button" aria-label="Abrir menú" aria-expanded="false" aria-controls="menu">
      <span></span>
      <span></span>
      <span></span>
    </button>
    <div class="internal-links" id="menu">
      <HeaderLink href={`${base}/archivo/`}>Archivo</HeaderLink>
      <HeaderLink href={`${base}/etiquetas/`}>Temas</HeaderLink>
      <HeaderLink href={`${base}/acerca/`}>Acerca</HeaderLink>
      <details class="nav-more">
        <summary>Más ▾</summary>
        <div class="dropdown-panel">
          <HeaderLink href={`${base}/bibliografia/`}>Bibliografía</HeaderLink>
          <HeaderLink href={`${base}/publicaciones/`}>Publicaciones</HeaderLink>
          <HeaderLink href={`${base}/libros/`}>Libros</HeaderLink>
          <HeaderLink href={`${base}/contacto/`}>Contacto</HeaderLink>
        </div>
      </details>
      <HeaderLink href={`${base}/buscar/`} class="enlace-buscar" aria-label="Buscar" title="Buscar (tecla /)"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg><span class="texto-buscar">Buscar</span></HeaderLink>
    </div>
  </nav>
</header>

<style>
  header {
    margin: 0;
    padding: 0 1em;
    background: white;
    box-shadow: 0 2px 8px rgba(var(--black), 5%);
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .brand {
    margin: 0;
    font-size: 1.6rem;
    font-weight: 400;
    line-height: 1;
  }

  .brand-link,
  .brand-link.active {
    display: inline-flex;
    align-items: center;
    line-height: 1;
    color: var(--black);
    text-decoration: none;
  }

  .logo-mark {
    width: 32px;
    height: 32px;
    flex: 0 0 32px;
    margin-right: 0.5em;
    transform: translateY(0.34em);
  }

  nav {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 2rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  nav a {
    display: inline-block;
    padding: 1.2rem 0;
    color: var(--black);
    text-decoration: none;
    border-bottom: 3px solid transparent;
  }

  nav a.active {
    border-bottom-color: var(--accent);
  }

  .internal-links {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    font-size: 1.1rem;
    white-space: nowrap;
    line-height: 1;
  }

  /* Desplegable "Más" (escritorio) con <details> */
  .nav-more {
    position: relative;
  }
  .nav-more > summary {
    list-style: none;
    cursor: pointer;
    color: var(--black);
    padding: 1.2rem 0;
    border-bottom: 3px solid transparent;
    white-space: nowrap;
  }
  .nav-more > summary::-webkit-details-marker {
    display: none;
  }
  .dropdown-panel {
    position: absolute;
    top: 100%;
    right: 0;
    min-width: 170px;
    background: white;
    box-shadow: 0 4px 12px rgba(var(--black), 10%);
    padding: 0.4rem 0;
    z-index: 100;
  }
  .nav-more[open] > .dropdown-panel {
    display: flex;
    flex-direction: column;
  }
  .dropdown-panel a {
    padding: 0.5rem 1.1rem;
    border-bottom: none;
    white-space: nowrap;
  }
  .dropdown-panel a:hover {
    background: rgb(var(--gray-light));
  }

  /* Buscar: en el ordenador, solo la lupa; en el menú del móvil, lupa y texto. */
  .internal-links :global(.enlace-buscar) {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
  }
  .internal-links :global(.enlace-buscar svg) {
    display: block;
  }
  .texto-buscar {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  /* «nav» delante para pesar más que la regla general «nav a». */
  nav .lupa-movil {
    display: none;
  }

  /* Lupa y menú del móvil: misma caja de 44 × 44 px, dibujo centrado en ella. */
  .hamburger {
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    padding: 0;
    background: none;
    border: none;
    cursor: pointer;
    color: rgb(var(--black));
  }

  .hamburger span {
    display: block;
    width: 20px;
    height: 2px;
    border-radius: 1px;
    background: currentColor;
    transition: transform 0.2s, opacity 0.2s;
  }

  /* Abierto: las tres líneas forman una ✕. */
  .hamburger[aria-expanded='true'] span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .hamburger[aria-expanded='true'] span:nth-child(2) {
    opacity: 0;
  }
  .hamburger[aria-expanded='true'] span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .hamburger span {
      transition: none;
    }
  }

  @media (max-width: 640px) {
    nav {
      align-items: center;
      gap: 0.25rem;
    }

    /* El dibujo del menú queda a 1em del borde, como el logotipo por la izquierda. */
    .hamburger {
      display: flex;
      margin-right: -12px;
    }

    /* Lupa y menú a la altura del centro del logotipo, que va algo bajado
       (ver .logo-mark). */
    .hamburger,
    nav .lupa-movil {
      transform: translateY(5px);
    }

    nav .lupa-movil {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 44px;
      height: 44px;
      margin-left: auto;
      padding: 0;
      border-bottom: none;
    }

    /* En el desplegable, «Buscar» sin lupa: alineado con los demás enlaces. */
    .internal-links :global(.enlace-buscar svg) {
      display: none;
    }

    .texto-buscar {
      position: static;
      width: auto;
      height: auto;
      overflow: visible;
      clip: auto;
    }

    .internal-links {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: white;
      flex-direction: column;
      align-items: flex-start;
      gap: 0;
      box-shadow: 0 6px 12px -4px rgba(var(--black), 12%);
      /* Mismo margen que la cabecera: los enlaces empiezan donde el logotipo. */
      padding: 0.5rem 1em 1rem;
    }

    .internal-links.open {
      display: flex;
    }

    /* El tamaño va en los enlaces, no en el contenedor: así su 1em de margen es el
       mismo que el de la cabecera. */
    .internal-links a {
      font-size: 1rem;
      padding: 0.6rem 0;
      width: 100%;
      border-bottom: 1px solid rgb(var(--gray-light));
    }

    .internal-links > a:last-child {
      border-bottom: none;
    }

    /* En móvil se aplana "Más": se oculta el botón y se muestran sus enlaces */
    .nav-more {
      width: 100%;
    }
    .nav-more > summary {
      display: none;
    }
    .dropdown-panel {
      display: flex;
      flex-direction: column;
      position: static;
      box-shadow: none;
      background: none;
      padding: 0;
      min-width: 0;
    }
  }
</style>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('menu');

  // Menú del móvil: ☰ se convierte en ✕; se cierra al tocar fuera, con Escape
  // o al elegir un enlace.
  function abrirMenu(abrir: boolean) {
    if (!toggle || !menu) return;
    menu.classList.toggle('open', abrir);
    toggle.setAttribute('aria-expanded', String(abrir));
    toggle.setAttribute('aria-label', abrir ? 'Cerrar menú' : 'Abrir menú');
  }
  const menuAbierto = () => menu?.classList.contains('open') ?? false;

  toggle?.addEventListener('click', () => abrirMenu(!menuAbierto()));
  document.addEventListener('click', (e) => {
    const el = e.target as Node;
    if (menuAbierto() && !menu?.contains(el) && !toggle?.contains(el)) abrirMenu(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menuAbierto()) {
      abrirMenu(false);
      toggle?.focus();
    }
  });
  menu?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) abrirMenu(false);
  });

  // "Mas": abierto en movil (lista plana), desplegable en escritorio.
  const more = document.querySelector('.nav-more');
  const mq = window.matchMedia('(max-width: 640px)');
  function syncMore() { if (more) more.open = mq.matches; }
  syncMore();
  mq.addEventListener('change', syncMore);

  // En escritorio, cerrar "Mas" al pulsar fuera o con Escape.
  document.addEventListener('click', (e) => {
    if (!more || mq.matches) return;
    if (more.open && !more.contains(e.target)) more.open = false;
  });
  document.addEventListener('keydown', (e) => {
    if (more && !mq.matches && e.key === 'Escape') more.open = false;
  });

  // Tecla «/»: abre el buscador (o pone el cursor en él si ya se está en /buscar/),
  // salvo cuando se está escribiendo en un campo.
  document.addEventListener('keydown', (e) => {
    if (e.key !== '/' || e.ctrlKey || e.metaKey || e.altKey) return;
    const el = e.target as HTMLElement | null;
    if (el && (el.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(el.tagName))) return;
    e.preventDefault();
    const campo = document.getElementById('buscador-q') as HTMLInputElement | null;
    if (campo) {
      campo.focus();
      campo.select();
    } else {
      location.href = '/buscar/';
    }
  });
</script>
