---
// Al llegar desde /buscar/, la dirección lleva ?resaltar=palabras.
// Este componente resalta esas palabras en el texto y lleva a la primera
// (salvo que la dirección ya apunte a un apartado con #).
// Sin ?resaltar= no carga nada.
---

<script is:inline>
	(function () {
		var params = new URLSearchParams(location.search);
		if (!params.has('resaltar')) return;
		// Desde una búsqueda con frase exacta, el buscador manda la frase entera
		// (?resaltar=te quiero): se resalta solo donde aparece completa y como palabras
		// enteras, no «te» dentro de «este».
		var conFrase = params.getAll('resaltar').some(function (t) { return /\s/.test(t.trim()); });
		var opciones = { highlightParam: 'resaltar' };
		if (conFrase) {
			opciones.markOptions = {
				className: 'pagefind-highlight',
				acrossElements: true,
				accuracy: {
					value: 'exactly',
					limiters: ',.;:¡!¿?«»“”"\'‘’()[]—–-…'.split(''),
				},
			};
		}
		import('/pagefind/pagefind-highlight.js')
			.then(function () {
				new PagefindHighlight(opciones);
				if (location.hash) return;
				var intentos = 0;
				(function irALaPrimera() {
					var marca = document.querySelector('mark.pagefind-highlight');
					if (marca) {
						marca.scrollIntoView({ block: 'center' });
					} else if (++intentos < 20) {
						setTimeout(irALaPrimera, 100);
					}
				})();
			})
			.catch(function (error) {
				console.error(error);
			});
	})();
</script>

<style is:global>
	mark.pagefind-highlight {
		background: #ffeaa0;
		color: inherit;
		border-radius: 2px;
		padding: 0 1px;
	}
	/* Bloque solo para el buscador: no se ve ni lo leen los lectores de pantalla. */
	.solo-buscador {
		position: absolute;
		width: 1px;
		height: 1px;
		margin: -1px;
		padding: 0;
		overflow: hidden;
		clip: rect(0 0 0 0);
		white-space: nowrap;
		border: 0;
	}
</style>
