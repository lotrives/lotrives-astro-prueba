---
interface Props {
	date: Date;
	compact?: boolean;
	compactOnMobile?: boolean;
}

const { date, compact = false } = Astro.props;

// Una sola fecha, escrita y visible igual en todas las pantallas, para que las vistas
// de lectura (Safari, X…), los buscadores y los lectores de pantalla vean lo mismo.
// compactOnMobile se acepta por compatibilidad: ahora se muestra siempre la fecha larga.

const longDate = date.toLocaleDateString('es-ES', {
	year: 'numeric',
	month: 'long',
	day: 'numeric',
});

const shortDate = date
	.toLocaleDateString('es-ES', {
		year: 'numeric',
		month: 'short',
		day: 'numeric',
	})
	.replace(/\./g, '')
	.replace(/\bsept\b/, 'sep');
---

<time datetime={date.toISOString()}>{compact ? shortDate : longDate}</time>

<style>
	time {
		white-space: nowrap;
	}
</style>
