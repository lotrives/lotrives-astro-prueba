---
interface Props {
	date: Date;
	compact?: boolean;
	compactOnMobile?: boolean;
}

const { date, compact = false, compactOnMobile = false } = Astro.props;

// Una sola fecha en el HTML. Con compactOnMobile, en pantallas estrechas se ve la corta
// mediante ::after (data-corta); las vistas de lectura, los buscadores y los lectores
// de pantalla ven solo la larga, sin repetirla.

const longDate = date.toLocaleDateString('es-ES', {
	year: 'numeric',
	month: 'long',
	day: 'numeric',
});

const shortDate = date
	.toLocaleDateString('es-ES', {
		year: 'numeric',
		month: 'short',
		day: 'numeric',
	})
	.replace(/\./g, '')
	.replace(/\bsept\b/, 'sep');
---

<!--
	Una sola fecha en el HTML. Con compactOnMobile, en pantallas estrechas se ve la corta
	mediante ::after (data-corta); las vistas de lectura, los buscadores y los lectores
	de pantalla solo ven la larga, sin repetirla.
-->
{
	compact ? (
		<time datetime={date.toISOString()}>{shortDate}</time>
	) : compactOnMobile ? (
		<time datetime={date.toISOString()} class="date-responsive" data-corta={shortDate}><span class="date-long">{longDate}</span></time>
	) : (
		<time datetime={date.toISOString()}>{longDate}</time>
	)
}

<style>
	time {
		white-space: nowrap;
	}

	@media (max-width: 560px) {
		.date-responsive .date-long {
			display: none;
		}

		.date-responsive::after {
			content: attr(data-corta);
		}
	}
</style>
