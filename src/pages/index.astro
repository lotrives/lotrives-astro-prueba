---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import TarjetaTexto from '../components/TarjetaTexto.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';

import { urlTexto, ordenarPublicados } from '../utils/url';
import { etiquetasConPagina, pildorasDe } from '../utils/etiquetas';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const conPagina = await etiquetasConPagina();

// Los 8 textos más recientes, sin distinguir tipos.
const items = ordenarPublicados(await getCollection('blog'))
  .slice(0, 8)
  .map((post) => ({
    date: new Date(post.data.pubDate),
    title: post.data.title,
    description: post.data.description,
    heroImage: post.data.heroImage,
    href: urlTexto(post),
    etiquetas: pildorasDe(post.data.tags, conPagina),
  }));
---

<!doctype html>
<html lang="es">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <style>
      .intro {
        margin-top: 0;
        margin-bottom: 0;
        padding-bottom: 1.5rem;
        border-bottom: 1px solid rgb(var(--gray-light));
      }
      .intro-linea1 {
        margin: 0 0 0.2em;
        font-size: 1.25em;
        font-weight: 600;
        color: rgb(var(--black));
        line-height: 1.4;
      }
      .intro-linea2 {
        margin: 0;
        font-size: 1.25em;
        font-weight: 400;
        color: rgb(var(--gray));
        line-height: 1.4;
      }
      @media (max-width: 720px) {
        .intro-linea1, .intro-linea2 {
          font-size: 1.1em;
        }
      }
      .lista-textos {
        margin: 0;
      }
      .ver-todos {
        margin-top: 1.5rem;
      }
      .ver-todos a {
        color: rgb(var(--gray));
        text-decoration: none;
      }
      .ver-todos a:hover {
        color: var(--accent);
        text-decoration: underline;
        text-underline-offset: 3px;
        text-decoration-color: var(--accent);
      }
    </style>
  </head>
  <body>
    <Header />
    <main style="max-width: 700px; margin: 0 auto; padding: 1.5rem;">
      <div class="intro">
        <h1 class="intro-linea1">Artículos y notas de José Manuel Grau Navarro</h1>
        <p class="intro-linea2">Una mirada al mundo que somos</p>
      </div>

      <div class="lista-textos">
        {items.map((item) => (
          <TarjetaTexto
            title={item.title}
            description={item.description}
            href={item.href}
            date={item.date}
            heroImage={item.heroImage}
            etiquetas={item.etiquetas}
          />
        ))}
      </div>
      <p class="ver-todos">
        <a href={`${base}/archivo/`}>Todos los textos →</a>
      </p>
    </main>
    <Footer />
  </body>
</html>
