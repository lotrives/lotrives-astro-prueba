---
// Una página por etiqueta, generada sola a partir de los textos.
// Solo existen para las etiquetas con 3 o más entradas (ver src/utils/etiquetas.ts).
//
// Mismo formato de tarjeta que la portada (TarjetaTexto):
// - primero las páginas estáticas con esa etiqueta (sin fecha), en un bloque aparte;
// - después los textos, del más reciente al más antiguo;
// - en el antetítulo no se repite la etiqueta de la propia página.
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import TarjetaTexto from '../../components/TarjetaTexto.astro';
import { urlTexto } from '../../utils/url';
import { etiquetasConPagina, pildorasDe } from '../../utils/etiquetas';

export async function getStaticPaths() {
	const conPagina = await etiquetasConPagina();
	return [...conPagina.values()].map((info) => ({
		params: { etiqueta: info.slug },
		props: { info },
	}));
}

const { info } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const conPagina = await etiquetasConPagina();

const paginas = [...info.paginas]
	.sort((a, b) => a.data.title.localeCompare(b.data.title, 'es'))
	.map((pg) => ({
		href: `${base}/${pg.id.replace(/\.mdx?$/, '')}/`,
		title: pg.data.title,
		description: pg.data.description,
		etiquetas: pildorasDe(pg.data.tags, conPagina, info.slug),
	}));

// info.textos ya viene ordenado del más reciente al más antiguo.
const textos = info.textos.map((t) => ({
	href: urlTexto(t),
	title: t.data.title,
	description: t.data.description,
	date: new Date(t.data.pubDate),
	heroImage: t.data.heroImage,
	etiquetas: pildorasDe(t.data.tags, conPagina, info.slug),
}));

const n = info.total;
const descripcion = `${n} textos de Lotrives sobre ${info.nombre}.`;
const dosBloques = paginas.length > 0 && textos.length > 0;
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={info.nombre} description={descripcion} />
	</head>
	<body>
		<Header />
		<main>
			<section class="page">
				<p class="volver"><a href={`${base}/etiquetas/`}>← Temas</a></p>
				<h1>{info.nombre}</h1>
				<p class="resumen">{n} {n === 1 ? 'entrada' : 'entradas'}</p>

				{
					paginas.length > 0 && (
						<div class="bloque">
							{dosBloques && <h2 class="bloque-titulo">{paginas.length === 1 ? 'Página' : 'Páginas'}</h2>}
							<div class="lista">
								{paginas.map((p) => (
									<TarjetaTexto title={p.title} description={p.description} href={p.href} etiquetas={p.etiquetas} />
								))}
							</div>
						</div>
					)
				}

				{
					textos.length > 0 && (
						<div class="bloque">
							{dosBloques && <h2 class="bloque-titulo">Textos</h2>}
							<div class="lista">
								{textos.map((t) => (
									<TarjetaTexto
										title={t.title}
										description={t.description}
										href={t.href}
										date={t.date}
										heroImage={t.heroImage}
										etiquetas={t.etiquetas}
									/>
								))}
							</div>
						</div>
					)
				}
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.page {
		max-width: 700px;
		margin: 0 auto;
		padding: 1.5rem 1.5rem;
	}
	.volver {
		margin: 0 0 1rem;
		font-size: 0.9em;
	}
	h1 {
		margin: 0 0 0.3rem;
		font-size: 2.25rem;
		line-height: 1.1;
	}
	.resumen {
		margin: 0;
		padding-bottom: 1.2rem;
		border-bottom: 1px solid rgb(var(--gray-light));
		font-size: 0.9em;
		color: rgb(var(--gray));
	}
	.bloque + .bloque {
		margin-top: 1.5rem;
	}
	/* Rótulo de bloque, en el mismo registro que el antetítulo de las tarjetas. */
	.bloque-titulo {
		margin: 1.4rem 0 0;
		font-size: 0.7rem;
		font-weight: 600;
		letter-spacing: 0.09em;
		text-transform: uppercase;
		color: rgb(var(--gray));
	}
</style>
