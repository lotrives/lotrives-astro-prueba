---
// Una página por etiqueta, generada sola a partir de los textos.
// Solo existen para las etiquetas con 3 o más entradas (ver src/utils/etiquetas.ts).
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { urlTexto } from '../../utils/url';
import { etiquetasConPagina } from '../../utils/etiquetas';

export async function getStaticPaths() {
	const conPagina = await etiquetasConPagina();
	return [...conPagina.values()].map((info) => ({
		params: { etiqueta: info.slug },
		props: { info },
	}));
}

const { info } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const entradas = [
	...info.paginas.map((pg) => ({
		url: `${base}/${pg.id.replace(/\.mdx?$/, '')}/`,
		title: pg.data.title,
		fecha: null as Date | null,
		pagina: true,
	})),
	...info.textos.map((t) => ({
		url: urlTexto(t),
		title: t.data.title,
		fecha: new Date(t.data.pubDate) as Date | null,
		pagina: false,
	})),
];

const n = info.total;
const descripcion = `${n} textos de Lotrives sobre ${info.nombre}.`;
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={info.nombre} description={descripcion} />
	</head>
	<body>
		<Header />
		<main>
			<section class="page">
				<p class="volver"><a href={`${base}/etiquetas/`}>← Índice</a></p>
				<h1>{info.nombre}</h1>
				<p class="resumen">{n} {n === 1 ? 'entrada' : 'entradas'}</p>
				<ul class="entradas">
					{
						entradas.map((e) => (
							<li>
								<a href={e.url}>{e.title}</a>
								{e.fecha && (
									<span class="fecha">
										<FormattedDate date={e.fecha} compact />
									</span>
								)}
								{e.pagina && <span class="fecha"> · página</span>}
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.page {
		max-width: 700px;
		margin: 0 auto;
		padding: 1.5rem 1.5rem;
	}
	.volver {
		margin: 0 0 1rem;
		font-size: 0.9em;
	}
	h1 {
		margin: 0 0 0.3rem;
		font-size: 2.25rem;
		line-height: 1.1;
	}
	.resumen {
		margin: 0 0 1.5rem;
		font-size: 0.9em;
		color: rgb(var(--gray));
	}
	.entradas {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.entradas li {
		margin-bottom: 0.6em;
		font-size: 1.05rem;
		line-height: 1.5;
	}
	.fecha {
		font-size: 0.75em;
		color: rgb(var(--gray));
		margin-left: 0.4em;
		letter-spacing: 0.04em;
	}
</style>
