---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead
			title="Buscar | Lotrives"
			description="Buscar en Lotrives."
		/>
	
<style is:global>
	.page {
		max-width: 700px;
		margin: 0 auto;
		padding: 4rem 1.5rem;
	}
	h1 {
		margin: 0 0 2rem;
		font-size: 2.5rem;
		line-height: 1;
	}
	.b-card {
		border: 1px solid #e0e0e0;
		border-radius: 4px;
		padding: 1rem 1.2rem;
		margin-bottom: 0.8rem;
	}
	.b-card:hover { border-color: #aaa; }
	.b-card-header {
		display: flex;
		align-items: baseline;
		gap: 0.5em;
		margin-bottom: 0.25rem;
	}
	.b-card-header a {
		font-size: 1.05rem;
		font-weight: 600;
		color: #3273dc;
		text-decoration: none;
	}
	.b-card-header a:hover { text-decoration: underline; }
	.b-type {
		font-size: 0.7em;
		color: #fff;
		background: #888;
		border-radius: 3px;
		padding: 1px 6px;
		white-space: nowrap;
	}
	.b-date {
		font-size: 0.75rem;
		color: #aaa;
		margin-bottom: 0.5rem;
		white-space: nowrap;
	}

	.b-date-short {
		display: none;
	}

	@media (max-width: 560px) {
		.b-date-long {
			display: none;
		}

		.b-date-short {
			display: inline;
		}
	}
	.b-excerpt {
		font-size: 0.875rem;
		color: #555;
		line-height: 1.55;
		margin-bottom: 0.6rem;
	}
	.b-excerpt mark {
		background: #ffeaa0;
		border-radius: 2px;
		padding: 0 2px;
	}
	.b-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
		margin-top: 0.25rem;
	}
	.b-tag {
		font-size: 0.72rem;
		color: #555;
		background: #f0f0f0;
		border-radius: 3px;
		padding: 2px 7px;
		white-space: nowrap;
	}
	.b-tag mark {
		background: #ffeaa0;
		border-radius: 2px;
		padding: 0 1px;
	}
	.b-nada { font-style: italic; color: #888; }
</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="page">
				<h1>Buscar</h1>

				<input type="search" id="buscador-q" placeholder="Busca títulos, textos, etiquetas…" autocomplete="off" disabled style="width:100%;max-width:480px;padding:0.75rem 1rem;font-size:1rem;box-sizing:border-box;margin-top:1rem;">

				<div id="buscador-status" style="font-size:0.8rem;color:#888;margin:0.75rem 0 1rem;min-height:1.2em;"></div>
				<div id="buscador-results"></div>
			</section>
		</main>
		<Footer />

		<script type="module" is:inline>
		(function () {
			var pagefind;
			var searchVersion = 0;

			var input = document.getElementById('buscador-q');
			var status = document.getElementById('buscador-status');
			var results = document.getElementById('buscador-results');

			function esc(str) {
				return String(str || '')
					.replace(/&/g, '&amp;')
					.replace(/</g, '&lt;')
					.replace(/>/g, '&gt;')
					.replace(/"/g, '&quot;');
			}

			function fmtDate(raw, compact) {
				if (!raw) return '';

				var d = new Date(raw);
				if (Number.isNaN(d.getTime())) return raw;

				return d.toLocaleDateString('es-ES', {
					year: 'numeric',
					month: compact ? 'short' : 'long',
					day: 'numeric'
				})
					.replace(/\./g, '')
					.replace(/\bsept\b/, 'sep');
			}

			function renderCards(items) {
				return items.map(function (p) {
					var meta = p.meta || {};
					var type = meta.type || '';

					var typeTag = (type === 'nota' || type === 'página')
						? '<span class="b-type">' + esc(type) + '</span>'
						: '';

					var tagsHtml = meta.tags
						? String(meta.tags).split(', ').map(function (tag) {
							return '<span class="b-tag">' + esc(tag.trim()) + '</span>';
						}).join('')
						: '';

					var excerptHtml = p.excerpt || esc(meta.excerpt || '');

					return '<div class="b-card">' +
						'<div class="b-card-header"><a href="' + esc(p.url) + '">' +
							esc(meta.title || '') +
						'</a>' + (typeTag ? ' ' + typeTag : '') + '</div>' +
						(meta.date_iso
							? '<div class="b-date">' +
								'<span class="b-date-long">' + esc(fmtDate(meta.date_iso, false)) + '</span>' +
								'<span class="b-date-short">' + esc(fmtDate(meta.date_iso, true)) + '</span>' +
							  '</div>'
							: '') +
						'<div class="b-excerpt">' + excerptHtml + '</div>' +
						(tagsHtml ? '<div class="b-tags">' + tagsHtml + '</div>' : '') +
					'</div>';
				}).join('');
			}

			async function search(query) {
				var q = query.trim();
				var version = ++searchVersion;

				if (!q) {
					results.innerHTML = '';
					status.innerHTML = '';
					return;
				}

				status.innerHTML = 'Buscando…';

				try {
					var response = await pagefind.search(q);

					if (version !== searchVersion) return;

					var n = response.results.length;

					if (!n) {
						status.innerHTML = '0 resultados para "<strong>' + esc(q) + '</strong>"';
						results.innerHTML = '<p class="b-nada">No se encontró nada.</p>';
						return;
					}

					var items = await Promise.all(
						response.results.map(function (result) {
							return result.data();
						})
					);

					if (version !== searchVersion) return;

					status.innerHTML = n + ' resultado' + (n !== 1 ? 's' : '') +
						' para "<strong>' + esc(q) + '</strong>"';
					results.innerHTML = renderCards(items);
				} catch (error) {
					console.error(error);

					if (version !== searchVersion) return;

					status.innerHTML = 'Error al realizar la búsqueda.';
					results.innerHTML = '';
				}
			}

			async function init() {
				try {
					pagefind = await import('/pagefind/pagefind.js');
					await pagefind.init();

					input.disabled = false;
					input.focus();
					status.innerHTML = '';
				} catch (error) {
					console.error(error);
					status.innerHTML = 'Error al cargar el buscador.';
				}
			}

			var timer;

			input.addEventListener('input', function (e) {
				clearTimeout(timer);

				timer = setTimeout(function () {
					search(e.target.value);
				}, 250);
			});

			init();
		})();
		</script>
	</body>
</html>

