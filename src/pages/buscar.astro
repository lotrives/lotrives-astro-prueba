---
// Buscador. El índice lo construye scripts/build-pagefind.mjs a partir de las páginas
// compiladas (textos y páginas estáticas).
//
// - La búsqueda y los filtros quedan en la dirección
//   (/buscar/?q=varsovia&etiqueta=Polonia&epoca=1990&orden=asc): se puede enlazar y
//   el botón de volver atrás la conserva.
// - Filtros por etiqueta y por década (en la dirección sigue llamándose «epoca»);
//   orden por relevancia o por fecha.
// - Si lo buscado coincide con una etiqueta, se ofrece su página arriba.
// - Frases exactas entre comillas: "estado de bienestar" (también “…” y «…»). Pagefind
//   busca por la raíz de las palabras, así que los resultados se comprueban contra el
//   texto completo y solo quedan los que contienen la frase tal cual.
// - Sin resultados: sugerencias (palabra parecida, cada palabra por separado, sin filtros).
// - Resultados en tarjetas, como la portada, con el fragmento donde aparece lo buscado
//   y los apartados del texto que coinciden. De 20 en 20, con «Ver más».
// - Al abrir un resultado, el texto muestra resaltadas las palabras buscadas
//   (?resaltar=…; ver src/components/ResaltadoBusqueda.astro).
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import equivalencias from '../data/equivalencias-buscador.json';
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title="Buscar" description="Buscar en Lotrives." />
	</head>
	<body>
		<Header />
		<main>
			<section class="buscar">
				<h1>Buscar</h1>

				<form id="buscador-form" role="search" action="/buscar/" method="get">
					<label for="buscador-q" class="visualmente-oculto">Buscar en Lotrives</label>
					<input
						type="search"
						id="buscador-q"
						name="q"
						placeholder="Títulos, nombres, lugares, temas…"
						autocomplete="off"
						spellcheck="false"
						enterkeyhint="search"
						disabled
					/>
					<p class="ayuda">Para una frase exacta, escríbela entre comillas, por ejemplo: "estado de bienestar".</p>

					<div id="buscador-controles" class="controles" hidden>
						<label>
							<span>Etiqueta</span>
							<select id="f-etiqueta" name="etiqueta"><option value="">Todas</option></select>
						</label>
						<label>
							<span>Década</span>
							<select id="f-epoca" name="epoca"><option value="">Todas</option></select>
						</label>
						<label>
							<span>Orden</span>
							<select id="f-orden" name="orden">
								<option value="">Relevancia</option>
								<option value="desc">Más recientes</option>
								<option value="asc">Más antiguos</option>
							</select>
						</label>
					</div>
				</form>

				<p id="buscador-estado" class="estado" aria-live="polite"></p>
				<div id="buscador-etiqueta" class="aviso-etiqueta" hidden></div>
				<div id="buscador-sugerencias" class="sugerencias" hidden></div>
				<div id="buscador-resultados" class="resultados"></div>
				<button id="buscador-mas" class="ver-mas" type="button" hidden>Ver más</button>
			</section>
			<script type="application/json" id="buscador-equivalencias" set:html={JSON.stringify(equivalencias)} />
		</main>
		<Footer />

		<script is:inline>
			(function () {
				var POR_PAGINA = 20;
				var MAX_APARTADOS = 3;

				var form = document.getElementById('buscador-form');
				var input = document.getElementById('buscador-q');
				var controles = document.getElementById('buscador-controles');
				var selEtiqueta = document.getElementById('f-etiqueta');
				var selEpoca = document.getElementById('f-epoca');
				var selOrden = document.getElementById('f-orden');
				var estado = document.getElementById('buscador-estado');
				var avisoEtiqueta = document.getElementById('buscador-etiqueta');
				var sugerencias = document.getElementById('buscador-sugerencias');
				var lista = document.getElementById('buscador-resultados');
				var botonMas = document.getElementById('buscador-mas');

				var pagefind = null;
				var version = 0;
				var resultados = [];
				var mostrados = 0;
				var temporizador = 0;

				// Cargados al iniciar.
				var tablaAlias = {}; // variante → palabra real (Hoss → Höß); scripts/build-pagefind.mjs
				var etiquetas = []; // [{ n: nombre, s: slug, t: entradas }]; /buscar-etiquetas.json
				var aniosTotales = {}; // año → número de entradas
				var palabrasTitulos = {}; // palabra → entradas; /buscar-vocabulario.json

				// ------------------------------------------------------------------
				// Utilidades

				function esc(texto) {
					return String(texto == null ? '' : texto)
						.replace(/&/g, '&amp;')
						.replace(/</g, '&lt;')
						.replace(/>/g, '&gt;')
						.replace(/"/g, '&quot;');
				}

				function plano(texto) {
					return String(texto).normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().trim();
				}

				// ------------------------------------------------------------------
				// Frases exactas
				//
				// Pagefind reduce las palabras a su raíz, de modo que "te quiero" encuentra
				// también «te quiere». Para que las comillas cumplan lo que prometen, los
				// resultados de una búsqueda con frase se comprueban contra el texto completo
				// y solo quedan los que contienen la frase tal cual (sin distinguir mayúsculas
				// ni tildes). El fragmento se construye alrededor de esa frase.

				// El iPhone escribe “…” al teclear comillas; también valen «…» y „…".
				function normalizarComillas(texto) {
					return String(texto).replace(/[“”„«»]/g, '"');
				}

				function frasesDe(consulta) {
					var frases = [];
					String(consulta || '').replace(/"([^"]+)"/g, function (_, f) {
						f = f.trim();
						if (f) frases.push(f);
						return '';
					});
					return frases;
				}

				// Palabras de la consulta que no van entre comillas.
				function palabrasSueltas(consulta) {
					return String(consulta || '').replace(/"[^"]*"/g, ' ').replace(/"/g, ' ').split(/\s+/).filter(Boolean);
				}

				// Pliega letra a letra (sin tildes, en minúscula) conservando la longitud,
				// para que las posiciones del texto plegado sirvan en el original.
				function plegar(texto) {
					var s = String(texto || '');
					var out = '';
					for (var i = 0; i < s.length; i++) {
						var c = s[i];
						var f = c === '’' ? "'" : c.normalize('NFD').charAt(0).toLowerCase();
						out += f.length === 1 ? f : c;
					}
					return out;
				}

				function patronFrase(frase) {
					var cuerpo = plegar(frase).split(/\s+/).filter(Boolean).map(function (w) {
						return w.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
					}).join('\\s+');
					return new RegExp('(^|[^\\p{L}\\p{N}])(' + cuerpo + ')(?![\\p{L}\\p{N}])', 'u');
				}

				// Posición de la frase en el texto: { i, n } o null.
				function buscarFrase(texto, patron) {
					var m = patron.exec(plegar(texto));
					return m ? { i: m.index + m[1].length, n: m[2].length } : null;
				}

				function fragmentoFrase(texto, pos) {
					var ANTES = 110;
					var DESPUES = 140;
					var ini = Math.max(0, pos.i - ANTES);
					var fin = Math.min(texto.length, pos.i + pos.n + DESPUES);
					// Cortar en un espacio para no partir palabras.
					if (ini > 0) {
						var e1 = texto.indexOf(' ', ini);
						if (e1 !== -1 && e1 < pos.i) ini = e1 + 1;
					}
					if (fin < texto.length) {
						var e2 = texto.lastIndexOf(' ', fin);
						if (e2 > pos.i + pos.n) fin = e2;
					}
					var limpio = function (t) { return esc(t.replace(/\s+/g, ' ')); };
					return limpio(texto.slice(ini, pos.i)) +
						'<mark>' + limpio(texto.slice(pos.i, pos.i + pos.n)) + '</mark>' +
						limpio(texto.slice(pos.i + pos.n, fin));
				}

				// Al abrir el resultado se resalta la frase entera (y las palabras sueltas),
				// no cada palabra por separado. Ver ResaltadoBusqueda.astro.
				function conResaltado(url, terminos) {
					if (!url) return url;
					var almohadilla = url.indexOf('#');
					var hash = almohadilla === -1 ? '' : url.slice(almohadilla);
					var base = almohadilla === -1 ? url : url.slice(0, almohadilla);
					var interrogacion = base.indexOf('?');
					var ruta = interrogacion === -1 ? base : base.slice(0, interrogacion);
					var p = new URLSearchParams(interrogacion === -1 ? '' : base.slice(interrogacion + 1));
					p.delete('resaltar');
					terminos.forEach(function (t) { p.append('resaltar', t); });
					var qs = p.toString();
					return ruta + (qs ? '?' + qs : '') + hash;
				}

				// Carga los datos de cada resultado (de 25 en 25) y deja solo los que
				// contienen todas las frases. Devuelve [{ r, d }] con fragmento y enlace ya
				// preparados.
				async function filtrarPorFrases(lista, frases, consulta) {
					var patrones = frases.map(patronFrase);
					var terminos = frases.concat(palabrasSueltas(consulta));
					var quedan = [];
					for (var k = 0; k < lista.length; k += 25) {
						var datos = await Promise.all(lista.slice(k, k + 25).map(function (r) { return r.data(); }));
						datos.forEach(function (d, j) {
							var meta = d.meta || {};
							var contenido = d.content || '';
							var titulo = meta.title || '';
							var posiciones = patrones.map(function (p) { return buscarFrase(contenido, p); });
							var todas = patrones.every(function (p, n) {
								return posiciones[n] || buscarFrase(titulo, p);
							});
							if (!todas) return;
							var primera = posiciones.filter(Boolean).sort(function (a, b) { return a.i - b.i; })[0];
							var copia = Object.assign({}, d, {
								url: conResaltado(d.url, terminos),
								excerpt: primera ? fragmentoFrase(contenido, primera) : esc(contenido.slice(0, 200)),
								sub_results: (d.sub_results || [])
									.filter(function (s) {
										var sinMarcas = (s.excerpt || '').replace(/<[^>]+>/g, '');
										return patrones.some(function (p) { return buscarFrase(sinMarcas, p); });
									})
									.map(function (s) {
										return Object.assign({}, s, { url: conResaltado(s.url, terminos), excerpt: '' });
									}),
							});
							quedan.push({ r: lista[k + j], d: copia });
						});
					}
					return quedan;
				}

				function fechaLarga(iso) {
					if (!iso) return '';
					var d = new Date(iso + 'T00:00:00Z');
					if (isNaN(d.getTime())) return '';
					return d.toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
				}

				function urlEtiqueta(nombre) {
					var e = etiquetas.find(function (x) { return x.n === nombre; });
					return e ? '/etiquetas/' + e.s + '/' : null;
				}

				function conFormaReal(q) {
					return q.replace(/[\p{L}'’]+/gu, function (palabra) {
						return tablaAlias[palabra.toLowerCase()] || palabra;
					});
				}

				function distancia(a, b) {
					if (Math.abs(a.length - b.length) > 2) return 99;
					var prev = [];
					for (var j = 0; j <= b.length; j++) prev[j] = j;
					for (var i = 1; i <= a.length; i++) {
						var actual = [i];
						for (var k = 1; k <= b.length; k++) {
							actual[k] = Math.min(prev[k] + 1, actual[k - 1] + 1, prev[k - 1] + (a[i - 1] === b[k - 1] ? 0 : 1));
						}
						prev = actual;
					}
					return prev[b.length];
				}

				function decadaDe(anio) {
					return String(Math.floor(Number(anio) / 10) * 10);
				}

				function etiquetaDecada(d) {
					return d + '–' + (Number(d) + 9);
				}

				// ------------------------------------------------------------------
				// Estado en la dirección

				function leerDireccion() {
					var p = new URLSearchParams(location.search);
					input.value = p.get('q') || '';
					ponerValor(selEtiqueta, p.get('etiqueta') || '');
					ponerValor(selEpoca, p.get('epoca') || '');
					selOrden.value = ['asc', 'desc'].indexOf(p.get('orden')) !== -1 ? p.get('orden') : '';
				}

				function escribirDireccion() {
					var p = new URLSearchParams();
					if (input.value.trim()) p.set('q', input.value.trim());
					if (selEtiqueta.value) p.set('etiqueta', selEtiqueta.value);
					if (selEpoca.value) p.set('epoca', selEpoca.value);
					if (selOrden.value) p.set('orden', selOrden.value);
					var url = '/buscar/' + (p.toString() ? '?' + p.toString() : '');
					if (location.pathname + location.search !== url) history.replaceState(null, '', url);
				}

				// Un <select> solo acepta valores que tenga como opción: si aún no la tiene, se crea.
				function ponerValor(sel, valor) {
					if (valor && !Array.prototype.some.call(sel.options, function (o) { return o.value === valor; })) {
						var o = document.createElement('option');
						o.value = valor;
						o.textContent = sel === selEpoca ? etiquetaDecada(valor) : valor;
						sel.appendChild(o);
					}
					sel.value = valor;
				}

				// ------------------------------------------------------------------
				// Filtros

				function filtrosPara(conEtiqueta, conEpoca) {
					var f = {};
					if (conEtiqueta && selEtiqueta.value) f.etiqueta = selEtiqueta.value;
					if (conEpoca && selEpoca.value) {
						var anios = Object.keys(aniosTotales).filter(function (a) { return decadaDe(a) === selEpoca.value; });
						f.anio = { any: anios.length ? anios : ['ninguno'] };
					}
					return f;
				}

				// Recuentos de cada opción para la búsqueda actual, sin contar el filtro de ese mismo campo
				// (para que el desplegable diga cuántos habría al cambiar de etiqueta o de época).
				// Con frases exactas, se cuentan solo los resultados que de verdad las contienen.
				async function recuentos(consulta, campo, filtrosSinCampo, frases) {
					if (!consulta && Object.keys(filtrosSinCampo).length === 0) {
						if (campo === 'anio') return aniosTotales;
						var tot = {};
						etiquetas.forEach(function (e) { tot[e.n] = e.t; });
						return tot;
					}
					var r = await pagefind.search(consulta, { filters: filtrosSinCampo });
					if (!frases || !frases.length) return (r.filters && r.filters[campo]) || {};
					var cuentas = {};
					(await filtrarPorFrases(r.results, frases, consulta)).forEach(function (x) {
						((x.d.filters && x.d.filters[campo]) || []).forEach(function (valor) {
							cuentas[valor] = (cuentas[valor] || 0) + 1;
						});
					});
					return cuentas;
				}

				function rellenarEtiquetas(cuentas) {
					var actual = selEtiqueta.value;
					var opciones = etiquetas
						.map(function (e) { return { n: e.n, c: cuentas[e.n] || 0 }; })
						.filter(function (e) { return e.c > 0 || e.n === actual; })
						.sort(function (a, b) { return b.c - a.c || a.n.localeCompare(b.n, 'es'); });
					selEtiqueta.innerHTML = '<option value="">Todas</option>' + opciones.map(function (e) {
						return '<option value="' + esc(e.n) + '">' + esc(e.n) + ' (' + e.c + ')</option>';
					}).join('');
					selEtiqueta.value = actual;
				}

				function rellenarEpocas(cuentasAnio) {
					var actual = selEpoca.value;
					var porDecada = {};
					Object.keys(cuentasAnio).forEach(function (a) {
						var d = decadaDe(a);
						porDecada[d] = (porDecada[d] || 0) + (cuentasAnio[a] || 0);
					});
					var decadas = Object.keys(porDecada)
						.filter(function (d) { return porDecada[d] > 0 || d === actual; })
						.sort();
					selEpoca.innerHTML = '<option value="">Todas</option>' + decadas.map(function (d) {
						return '<option value="' + d + '">' + etiquetaDecada(d) + ' (' + (porDecada[d] || 0) + ')</option>';
					}).join('');
					selEpoca.value = actual;
				}

				// ------------------------------------------------------------------
				// Tarjetas

				function tarjeta(r) {
					var meta = r.meta || {};
					var nombres = (meta.antetitulo || '').split('|').filter(Boolean);
					var html = '<article class="tarjeta"><div class="tarjeta-contenido">';

					var enlaces = nombres.map(function (nombre) {
						var href = urlEtiqueta(nombre);
						return href ? '<li><a href="' + href + '">' + esc(nombre) + '</a></li>' : '';
					}).join('');
					if (enlaces) html += '<ul class="antetitulo" aria-label="Etiquetas">' + enlaces + '</ul>';

					html += '<h2 class="tarjeta-titulo"><a href="' + esc(r.url) + '">' + esc(meta.title || r.url) + '</a></h2>';

					if (meta.fecha) {
						html += '<p class="tarjeta-fecha"><time datetime="' + esc(meta.fecha) + '">' + esc(fechaLarga(meta.fecha)) + '</time></p>';
					} else {
						html += '<p class="tarjeta-fecha">Página</p>';
					}

					if (r.excerpt) {
						// El fragmento lo da Pagefind ya escapado, con <mark> en lo buscado.
						html += '<p class="tarjeta-fragmento">…' + r.excerpt + '…</p>';
					}

					// Apartados: solo los que llevan a una sección concreta (#ancla), no al principio del texto.
					var apartados = (r.sub_results || []).filter(function (s) {
						return s.url && s.url.indexOf('#') !== -1 && s.title && s.title !== meta.title;
					}).slice(0, MAX_APARTADOS);

					if (apartados.length) {
						html += '<ul class="tarjeta-apartados" aria-label="Apartados donde aparece">' + apartados.map(function (s) {
							return '<li><a href="' + esc(s.url) + '">' + esc(s.title) + '</a>' +
								(s.excerpt ? '<span class="apartado-fragmento"> — …' + s.excerpt + '…</span>' : '') + '</li>';
						}).join('') + '</ul>';
					}

					return html + '</div></article>';
				}

				// Antetítulo en una sola línea, como en TarjetaTexto.astro: las etiquetas que
				// saltarían a la segunda línea se ocultan, desde la primera que no cabe.
				function ajustarAntetitulos() {
					lista.querySelectorAll('.antetitulo').forEach(function (ul) {
						var items = Array.prototype.slice.call(ul.children);
						items.forEach(function (li) { li.hidden = false; });
						ul.classList.add('ajustado');
						var primeraFila = items[0] ? items[0].offsetTop : 0;
						var cae = false;
						items.slice(1).forEach(function (li) {
							if (cae || li.offsetTop > primeraFila) {
								cae = true;
								li.hidden = true;
							}
						});
					});
				}

				async function mostrarMas(v) {
					var lote = resultados.slice(mostrados, mostrados + POR_PAGINA);
					botonMas.disabled = true;
					var datos = await Promise.all(lote.map(function (r) { return r.data(); }));
					if (v !== version) return;
					lista.insertAdjacentHTML('beforeend', datos.map(tarjeta).join(''));
					mostrados += lote.length;
					botonMas.hidden = mostrados >= resultados.length;
					botonMas.disabled = false;
					ajustarAntetitulos();
				}

				// ------------------------------------------------------------------
				// Etiqueta que coincide con lo buscado

				function etiquetasCoincidentes(q) {
					var nq = plano(q).replace(/["“”«»]/g, '').trim();
					if (nq.length < 3) return [];
					var exactas = etiquetas.filter(function (e) { return plano(e.n) === nq; });
					if (exactas.length) return exactas;
					var palabras = nq.split(/\s+/);
					return etiquetas
						.filter(function (e) {
							var suyas = plano(e.n).split(/[^a-z0-9]+/);
							return palabras.every(function (p) { return suyas.indexOf(p) !== -1; });
						})
						.sort(function (a, b) { return b.t - a.t; })
						.slice(0, 3);
				}

				function mostrarAvisoEtiqueta(q) {
					var coincidentes = q && !selEtiqueta.value ? etiquetasCoincidentes(q) : [];
					avisoEtiqueta.hidden = coincidentes.length === 0;
					avisoEtiqueta.innerHTML = coincidentes.map(function (e) {
						return '<p>Etiqueta <a href="/etiquetas/' + e.s + '/">' + esc(e.n) + '</a> · ' +
							e.t + (e.t === 1 ? ' entrada' : ' entradas') + '</p>';
					}).join('');
				}

				// ------------------------------------------------------------------
				// Sugerencias cuando no hay resultados

				var vocabulario = null; // palabra plana → { forma escrita, entradas }; títulos y etiquetas

				// Cuando una palabra no existe en el índice, Pagefind busca por su comienzo
				// («Ratsinger» acaba encontrando «rato»). Para no mostrar eso como resultados,
				// se exige que alguna coincidencia empiece de verdad como la palabra buscada.
				// Las palabras de etiquetas, equivalencias y variantes conocidas valen siempre.
				var confiables = null;

				function limpia(w) {
					return plano(w).replace(/[^\p{L}\p{N}]/gu, '');
				}

				function prefijoComun(a, b) {
					var i = 0;
					while (i < a.length && i < b.length && a[i] === b[i]) i++;
					return i;
				}

				function palabrasConfiables() {
					if (confiables) return confiables;
					confiables = {};
					var anadir = function (texto) {
						(String(texto).match(/[\p{L}\p{N}]+/gu) || []).forEach(function (w) { confiables[limpia(w)] = true; });
					};
					etiquetas.forEach(function (e) { anadir(e.n); });
					Object.keys(tablaAlias).forEach(function (k) { anadir(k); anadir(tablaAlias[k]); });
					try {
						JSON.parse(document.getElementById('buscador-equivalencias').textContent || '[]')
							.forEach(function (grupo) { grupo.forEach(anadir); });
					} catch (e) {
						console.error(e);
					}
					return confiables;
				}

				// Palabras con las que coincidieron los primeros resultados: lo marcado en el
				// fragmento y las palabras del título, las etiquetas, la entradilla y los alias.
				function coincidenciasDe(datos) {
					var lista = [];
					datos.forEach(function (d) {
						(d.excerpt.match(/<mark>[\s\S]*?<\/mark>/g) || []).forEach(function (m) {
							lista.push(limpia(m.replace(/<\/?mark>/g, '')));
						});
						var meta = d.meta || {};
						[meta.title, meta.etiquetas, meta.entradilla, meta.alias].forEach(function (t) {
							(String(t || '').match(/[\p{L}\p{N}]+/gu) || []).forEach(function (w) { lista.push(limpia(w)); });
						});
					});
					return lista;
				}

				function palabraConfirmada(palabra, coincidencias) {
					var p = limpia(palabra);
					if (!p || palabrasConfiables()[p]) return true;
					var necesario = p.length <= 4 ? p.length : Math.max(4, p.length - 3);
					return coincidencias.some(function (c) { return prefijoComun(p, c) >= necesario; });
				}

				/** Palabras de la consulta que ningún resultado contiene de verdad. */
				async function palabrasSinCoincidencia(consulta, respuesta) {
					if (/["“”]/.test(consulta) || !respuesta.results.length) return [];
					var datos = await Promise.all(respuesta.results.slice(0, 5).map(function (r) { return r.data(); }));
					var coincidencias = coincidenciasDe(datos);
					return consulta.split(/\s+/).filter(function (w) { return !palabraConfirmada(w, coincidencias); });
				}

				function palabraParecida(palabra) {
					if (!vocabulario) {
						vocabulario = {};
						var anadir = function (w, n) {
							var k = plano(w);
							if (!vocabulario[k] || vocabulario[k].n < n) vocabulario[k] = { w: w, n: n };
						};
						Object.keys(palabrasTitulos).forEach(function (w) { anadir(w, palabrasTitulos[w]); });
						etiquetas.forEach(function (e) {
							(e.n.match(/[\p{L}]+/gu) || []).forEach(function (w) {
								if (w.length >= 4) anadir(w, e.t);
							});
						});
					}
					var p = plano(palabra);
					if (p.length < 4 || vocabulario[p]) return null;
					var maximo = p.length <= 5 ? 1 : 2;
					var mejor = null;
					var mejorDistancia = maximo + 1;
					var mejorEntradas = 0;
					Object.keys(vocabulario).forEach(function (v) {
						var d = distancia(p, v);
						// La más parecida; a igual parecido, la más frecuente.
						if (d < mejorDistancia || (d === mejorDistancia && d <= maximo && vocabulario[v].n > mejorEntradas)) {
							mejorDistancia = d;
							mejor = vocabulario[v].w;
							mejorEntradas = vocabulario[v].n;
						}
					});
					return mejor;
				}

				function enlaceBusqueda(texto) {
					return '<a href="/buscar/?q=' + encodeURIComponent(texto) + '" data-q="' + esc(texto) + '">' + esc(texto) + '</a>';
				}

				async function mostrarSugerencias(q, consulta, v) {
					var partes = [];

					// Una frase entre comillas que no aparece: se ofrece buscar sus palabras sin comillas.
					if (consulta && /"/.test(consulta)) {
						var sinComillas = consulta.replace(/"/g, ' ').replace(/\s+/g, ' ').trim();
						var rs = await pagefind.search(sinComillas, { filters: filtrosPara(true, true) });
						if (v !== version) return;
						var dudosasSc = await palabrasSinCoincidencia(sinComillas, rs);
						if (rs.results.length && !dudosasSc.length) {
							partes.push('Sin comillas: ' + enlaceBusqueda(sinComillas) + ' (' + rs.results.length + ')');
						}
					}

					if (consulta) {
						// Las frases entre comillas no se corrigen: se buscan tal cual.
						var cambiada = /"/.test(consulta) ? consulta : consulta.replace(/[\p{L}]+/gu, function (w) { return palabraParecida(w) || w; });
						if (cambiada !== consulta) {
							var r = await pagefind.search(cambiada, { filters: filtrosPara(true, true) });
							if (v !== version) return;
							var siguenDudosas = await palabrasSinCoincidencia(cambiada, r);
							if (r.results.length && !siguenDudosas.length) partes.push('¿Quizá quisiste decir ' + enlaceBusqueda(cambiada) + '?');
						}

						// Palabras de 3 o más letras: «y», «de»… no ayudan por separado.
						var palabras = consulta.replace(/["“”]/g, '').split(/\s+/).filter(function (w) { return limpia(w).length >= 3; });
						if (palabras.length > 1) {
							var cuentas = await Promise.all(palabras.map(async function (w) {
								var x = await pagefind.search(w, { filters: filtrosPara(true, true) });
								var dudosas = await palabrasSinCoincidencia(w, x);
								return dudosas.length ? 0 : x.results.length;
							}));
							if (v !== version) return;
							var conAlgo = palabras
								.map(function (w, i) { return cuentas[i] ? enlaceBusqueda(w) + ' (' + cuentas[i] + ')' : ''; })
								.filter(Boolean);
							if (conAlgo.length) partes.push('Por separado: ' + conAlgo.join(' · '));
						}
					}

					if (selEtiqueta.value || selEpoca.value) {
						partes.push('<button type="button" class="quitar-filtros">Buscar sin filtros</button>');
					}

					sugerencias.hidden = partes.length === 0;
					sugerencias.innerHTML = partes.map(function (p) { return '<p>' + p + '</p>'; }).join('');
				}

				// ------------------------------------------------------------------
				// Búsqueda

				// «Polonia», la frase «te quiero», «“te quiero” Ucrania»: comillas españolas por
				// fuera y, dentro, las inglesas curvas.
				function consultaLegible(texto) {
					var unaFrase = /^"([^"]+)"$/.exec(texto);
					if (unaFrase) return 'la frase «' + esc(unaFrase[1].trim()) + '»';
					return '«' + esc(texto.replace(/"([^"]*)"/g, '“$1”')) + '»';
				}

				function textoEstado(n, q, consulta) {
					var que = q ? consultaLegible(q) + (consulta !== q ? ' (' + esc(consulta.replace(/"([^"]*)"/g, '“$1”')) + ')' : '') : '';
					var donde = [];
					if (selEtiqueta.value) donde.push('etiqueta «' + esc(selEtiqueta.value) + '»');
					if (selEpoca.value) donde.push(etiquetaDecada(selEpoca.value));
					var filtro = donde.length ? (que ? ' · ' : '') + donde.join(', ') : '';
					if (!n) return 'No se ha encontrado nada' + (que ? ' para ' + que : '') + filtro + '.';
					return n + (n === 1 ? ' resultado' : ' resultados') + (que ? ' para ' + que : '') + filtro;
				}

				function limpiar() {
					resultados = [];
					mostrados = 0;
					lista.innerHTML = '';
					estado.innerHTML = '';
					botonMas.hidden = true;
					avisoEtiqueta.hidden = true;
					sugerencias.hidden = true;
				}

				async function buscar() {
					var q = normalizarComillas(input.value.trim());
					var v = ++version;
					escribirDireccion();

					var consulta = q ? conFormaReal(q) : null;
					var frases = frasesDe(consulta);
					var filtros = filtrosPara(true, true);
					var hayFiltros = Object.keys(filtros).length > 0;

					if (!consulta && !hayFiltros) {
						limpiar();
						rellenarEtiquetas(await recuentos(null, 'etiqueta', {}));
						rellenarEpocas(aniosTotales);
						document.title = 'Buscar · Lotrives';
						return;
					}

					estado.innerHTML = 'Buscando…';
					try {
						// Sin texto (solo filtros) no hay relevancia: se ordena por fecha.
						var orden = selOrden.value || (consulta ? '' : 'desc');
						var opciones = { filters: filtros };
						if (orden) opciones.sort = { fecha: orden };

						var respuestas = await Promise.all([
							pagefind.search(consulta, opciones),
							recuentos(consulta, 'etiqueta', filtrosPara(false, true), frases),
							recuentos(consulta, 'anio', filtrosPara(true, false), frases),
						]);
						if (v !== version) return;

						// Frases exactas: solo los resultados que contienen la frase tal cual.
						if (frases.length) {
							var conFrase = await filtrarPorFrases(respuestas[0].results, frases, consulta);
							if (v !== version) return;
							respuestas[0] = {
								results: conFrase.map(function (x) {
									return { data: function () { return Promise.resolve(x.d); } };
								}),
							};
						}

						var sinCoincidencia = consulta ? await palabrasSinCoincidencia(consulta, respuestas[0]) : [];
						if (v !== version) return;
						var vacio = sinCoincidencia.length > 0;

						rellenarEtiquetas(vacio ? {} : respuestas[1]);
						rellenarEpocas(vacio ? {} : respuestas[2]);

						resultados = vacio ? [] : respuestas[0].results;
						mostrados = 0;
						lista.innerHTML = '';
						sugerencias.hidden = true;
						document.title = (q || selEtiqueta.value || 'Buscar') + ' · Buscar · Lotrives';
						estado.innerHTML = textoEstado(resultados.length, q, consulta);
						mostrarAvisoEtiqueta(q);
						botonMas.hidden = true;

						if (resultados.length) {
							await mostrarMas(v);
						} else {
							await mostrarSugerencias(q, consulta, v);
						}
					} catch (error) {
						console.error(error);
						if (v !== version) return;
						estado.innerHTML = 'Error al buscar.';
					}
				}

				// ------------------------------------------------------------------
				// Eventos

				input.addEventListener('input', function () {
					clearTimeout(temporizador);
					temporizador = setTimeout(buscar, 250);
				});

				form.addEventListener('submit', function (e) {
					e.preventDefault();
					clearTimeout(temporizador);
					buscar();
					input.blur(); // en el móvil, cierra el teclado
				});

				[selEtiqueta, selEpoca, selOrden].forEach(function (sel) {
					sel.addEventListener('change', function () { buscar(); });
				});

				botonMas.addEventListener('click', function () { mostrarMas(version); });

				sugerencias.addEventListener('click', function (e) {
					var enlace = e.target.closest('a[data-q]');
					if (enlace) {
						e.preventDefault();
						input.value = enlace.getAttribute('data-q');
						buscar();
						return;
					}
					if (e.target.closest('.quitar-filtros')) {
						selEtiqueta.value = '';
						selEpoca.value = '';
						buscar();
					}
				});

				var pendiente = 0;
				window.addEventListener('resize', function () {
					cancelAnimationFrame(pendiente);
					pendiente = requestAnimationFrame(ajustarAntetitulos);
				});

				// ------------------------------------------------------------------
				// Inicio

				(async function iniciar() {
					try {
						pagefind = await import('/pagefind/pagefind.js');
						await pagefind.options({
							highlightParam: 'resaltar',
							excerptLength: 30,
							// Peso de cada metadato (ver BlogPost.astro y Page.astro):
							// título > etiquetas > entradilla > cuerpo del texto (1).
							ranking: {
								metaWeights: { title: 10, etiquetas: 4, entradilla: 2, alias: 1, fecha: 1, antetitulo: 0 },
							},
						});
						await pagefind.init();
						var cargas = await Promise.all([
							pagefind.filters(),
							fetch('/buscar-alias.json').then(function (r) { return r.ok ? r.json() : {}; }).catch(function () { return {}; }),
							fetch('/buscar-etiquetas.json').then(function (r) { return r.ok ? r.json() : []; }).catch(function () { return []; }),
							fetch('/buscar-vocabulario.json').then(function (r) { return r.ok ? r.json() : {}; }).catch(function () { return {}; }),
						]);
						palabrasTitulos = cargas[3] || {};
						aniosTotales = (cargas[0] && cargas[0].anio) || {};
						tablaAlias = cargas[1] || {};
						etiquetas = cargas[2] || [];
					} catch (error) {
						console.error(error);
						estado.innerHTML = 'No se ha podido cargar el buscador.';
						return;
					}

					input.disabled = false;
					controles.hidden = false;
					leerDireccion();
					await buscar();
					if (!input.value) input.focus();
				})();
			})();
		</script>
	</body>
</html>

