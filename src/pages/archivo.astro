---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import FormattedDate from '../components/FormattedDate.astro';
import FloatingTOC from '../components/FloatingTOC.astro';
import PageScripts from '../components/PageScripts.astro';

import { urlTexto, ordenarPublicados } from '../utils/url';

// Todos los textos en una sola lista cronológica, agrupada por años.
// Los años con más de MESES_DESDE textos se dividen por meses, de forma automática.
const MESES_DESDE = 20;

const MESES = ['Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio', 'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'];

const sortedPosts = ordenarPublicados(await getCollection('blog'));

type Texto = (typeof sortedPosts)[number];

const postsByYear: Record<string, Texto[]> = {};
for (const post of sortedPosts) {
	const year = String(new Date(post.data.pubDate).getFullYear());
	(postsByYear[year] ??= []).push(post);
}

const years = Object.keys(postsByYear).sort((a, b) => Number(b) - Number(a));

// Para los años grandes: [mes, textos] en orden descendente (los textos ya vienen ordenados).
function porMeses(posts: Texto[]) {
	const meses = new Map<number, Texto[]>();
	for (const post of posts) {
		const mes = new Date(post.data.pubDate).getMonth();
		if (!meses.has(mes)) meses.set(mes, []);
		meses.get(mes)!.push(post);
	}
	return [...meses.entries()];
}

const postUrl = urlTexto;
const dosCifras = (n: number) => String(n + 1).padStart(2, '0');
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead
			title="Archivo"
			description="Archivo cronológico de todos los textos publicados en Lotrives."
		/>
	</head>
	<body>
		<Header />
		<main>
			<section class="page">
				<h1>Archivo</h1>

				<nav id="nav-anios" class="nav-anios" aria-label="Años">
					{years.map((year) => (
						<a href={`#year-${year}`}>{year}</a>
					))}
				</nav>

				{years.map((year) => {
					const posts = postsByYear[year];
					const conMeses = posts.length > MESES_DESDE;
					return (
						<section>
							<h2 class="archivo-anio" id={`year-${year}`}>
								{year} <a href="#nav-anios" class="volver-arriba" aria-label="Volver a los años">↑</a>
							</h2>
							{conMeses ? (
								porMeses(posts).map(([mes, textos]) => (
									<>
										<h3 class="archivo-mes" id={`mes-${year}-${dosCifras(mes)}`} data-ftoc-ignore>
											{MESES[mes]}
										</h3>
										<ul class="archivo-lista">
											{textos.map((post) => (
												<li>
													<a href={postUrl(post)}>{post.data.title}</a>
													<span class="archivo-fecha"><FormattedDate date={new Date(post.data.pubDate)} compact /></span>
												</li>
											))}
										</ul>
									</>
								))
							) : (
								<ul class="archivo-lista">
									{posts.map((post) => (
										<li>
											<a href={postUrl(post)}>{post.data.title}</a>
											<span class="archivo-fecha"><FormattedDate date={new Date(post.data.pubDate)} compact /></span>
										</li>
									))}
								</ul>
							)}
						</section>
					);
				})}
			</section>
		</main>
		<PageScripts />
		<FloatingTOC />
		<Footer />
	</body>
</html>

<style>
	.page {
		max-width: 700px;
		margin: 0 auto;
		padding: 1.5rem 1.5rem;
	}

	h1 {
		margin: 0 0 1.5rem;
		font-size: 2.5rem;
		line-height: 1;
	}

	.nav-anios {
		display: flex;
		flex-wrap: wrap;
		gap: 0.3em 0.9em;
		margin-bottom: 1.5em;
		font-size: 0.95em;
	}

	.nav-anios a {
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.archivo-anio {
		margin-top: 1.75em;
		padding-top: 0.6em;
		border-top: 1px solid rgb(var(--gray-light));
		margin-bottom: 0.5em;
		font-size: 1.75rem;
		line-height: 1.2;
		scroll-margin-top: 6rem;
	}

	.volver-arriba {
		font-size: 0.9em;
		text-decoration: none;
	}

	.archivo-mes {
		margin: 1.2em 0 0.4em;
		font-size: 1.15rem;
		line-height: 1.3;
		color: rgb(var(--gray));
		scroll-margin-top: 6rem;
	}

	.archivo-lista {
		list-style: none;
		margin-left: 0;
		padding-left: 0;
	}

	.archivo-lista li {
		margin-bottom: 0.5em;
		font-size: 1.05rem;
		line-height: 1.6;
	}

	.archivo-fecha {
		font-size: 0.75em;
		color: #999;
		margin-left: 0.4em;
		letter-spacing: 0.04em;
	}

	a {
		text-decoration-thickness: 1px;
		text-underline-offset: 0.15em;
	}
</style>
