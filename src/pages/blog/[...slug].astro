---
import { getCollection } from 'astro:content';
import { esFechado, idLimpio, urlTexto } from '../../utils/url';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts
    // Solo los textos con nombre fechado: las notas antiguas nunca estuvieron bajo /blog/.
    .filter((p) => !p.data.draft && esFechado(p))
    .map((post) => ({
      params: { slug: idLimpio(post) },
      props: { target: urlTexto(post) },
    }));
}

const { target } = Astro.props as { target: string };
const base = Astro.site?.href.replace(/\/$/, '') ?? 'https://lotrives.com';
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={base + target} />
    <title>Página movida</title>
  </head>
  <body>
    <p>Esta página se ha movido a <a href={target}>{target}</a>.</p>
  </body>
</html>
