---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogPost from '../layouts/BlogPost.astro';
import { rutaTexto, urlTexto, ordenarPublicados, descripcionDe } from '../utils/url';

// Todos los textos (antiguos artículos y notas) en una sola cronología.
// La dirección sale del nombre del archivo: ver src/utils/url.ts.
export async function getStaticPaths() {
	const sorted = ordenarPublicados(await getCollection('blog'));

	const truncate = (str: string, max: number) =>
		str.length > max ? str.slice(0, max).trimEnd() + '…' : str;

	return sorted.map((post, index) => {
		const newer = index > 0 ? sorted[index - 1] : null;
		const older = index < sorted.length - 1 ? sorted[index + 1] : null;

		return {
			params: { slug: rutaTexto(post) },
			props: {
				post,
				prev: newer ? { title: truncate(newer.data.title, 70), url: urlTexto(newer) } : null,
				next: older ? { title: truncate(older.data.title, 70), url: urlTexto(older) } : null,
			},
		};
	});
}

type Props = {
	post: CollectionEntry<'blog'>;
	prev: { title: string; url: string } | null;
	next: { title: string; url: string } | null;
};

const { post, prev, next } = Astro.props;
const { Content } = await render(post);
---

<BlogPost {...post.data} description={descripcionDe(post)} pubDate={new Date(post.data.pubDate)} prev={prev} next={next}>
	<Content />
</BlogPost>
