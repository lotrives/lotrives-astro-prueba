---
// /notas/ ya no es una sección aparte: todos los textos están en /archivo/.
// Las notas antiguas siguen en /notas/AAAAMMDD-HHMM/ (las genera src/pages/[...slug].astro).
const target = '/archivo/';
const base = Astro.site?.href.replace(/\/$/, '') ?? 'https://lotrives.com';
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={base + target} />
    <meta name="robots" content="noindex" />
    <title>Notas — ahora en el archivo</title>
  </head>
  <body>
    <p>Las notas están ahora en el <a href={target}>archivo</a>, junto con el resto de los textos.</p>
  </body>
</html>
